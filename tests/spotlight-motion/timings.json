{
  "duration": 16.824,
  "title": "اثر اسپاتلایت (تست)",
  "sentences": [
    {
      "start": 0.6,
      "end": 3.808,
      "text": "هیچ‌وقت شده حس کنی همه دارن بهت نگاه می‌کنن؟"
    },
    {
      "start": 4.258,
      "end": 6.776,
      "text": "انگار یه نورافکن بالای سرته."
    },
    {
      "start": 7.226,
      "end": 10.922,
      "text": "ولی واقعیت اینه که آدم‌ها خیلی کمتر دقت می‌کنن."
    },
    {
      "start": 11.372,
      "end": 13.452,
      "text": "هر کی داره به خودش فکر می‌کنه."
    },
    {
      "start": 13.902,
      "end": 15.024,
      "text": "پس راحت‌تر باش."
    }
  ]
}