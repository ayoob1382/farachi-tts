{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayoob1382/farachi-tts/blob/feat/farachi-motion-skills/schemas/farachi-project.schema.json",
  "title": "FARACHI Project Contract",
  "description": "Shared brief, narration, scene timeline and rendering settings. Version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "duration_seconds", "scenes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "language": { "type": "string", "default": "fa-IR" },
        "visual_focus": { "type": "string" },
        "aspect_ratio": { "type": "string", "default": "16:9" },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30 }
      }
    },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": { "type": "string" },
        "voice": { "type": "string" },
        "audio_file": { "type": "string" },
        "timings_file": { "type": "string", "default": "build/timings.json" }
      }
    },
    "selected_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "visual"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "narration_ref": { "type": "string" },
          "visual": { "type": "string", "minLength": 1 },
          "transition_in": { "type": "string" },
          "assets": { "type": "array", "items": { "type": "string" } },
          "skill_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "const": "render.js", "default": "render.js" },
        "scene_file": { "type": "string" },
        "output_file": { "type": "string" },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
